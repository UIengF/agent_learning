# API key for the primary OpenAI-compatible chat model. Default: empty.
RAG_MODEL_API_KEY=

# Backwards-compatible fallback API key for DashScope models when RAG_MODEL_API_KEY is unset. Default: empty.
DASHSCOPE_API_KEY=

# Base URL for the primary OpenAI-compatible chat model API. Default: https://dashscope.aliyuncs.com/compatible-mode/v1.
RAG_MODEL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model name for the primary chat model. Default: qwen3.6-plus.
RAG_MODEL_NAME=qwen3.6-plus

# DashScope embedding model name. Default: text-embedding-v3.
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Maximum embedding requests batched together. Default: 10.
DASHSCOPE_EMBEDDING_BATCH_SIZE=10

# Weight assigned to keyword retrieval in hybrid search. Default: 0.5.
RAG_KEYWORD_WEIGHT=0.5

# Enable web search and fetch tools. Default: true.
RAG_WEB_ENABLED=true

# Web search provider to use. Default: duckduckgo_html.
RAG_WEB_SEARCH_PROVIDER=duckduckgo_html

# Maximum number of web search results to request. Default: 5.
RAG_WEB_SEARCH_TOP_K=5

# Web fetch timeout in seconds. Default: 15.
RAG_WEB_FETCH_TIMEOUT_SECONDS=15

# Maximum bytes to download for a fetched web page. Default: 1500000.
RAG_WEB_FETCH_MAX_BYTES=1500000

# Maximum characters extracted from a fetched web page. Default: 6000.
RAG_WEB_FETCH_MAX_CHARS=6000

# User-Agent header used for web fetches. Default: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36 graph-rag-agent/1.0.
RAG_WEB_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36 graph-rag-agent/1.0

# Base URL for a SearXNG instance when RAG_WEB_SEARCH_PROVIDER=searxng. Default: http://127.0.0.1:8080.
RAG_SEARXNG_URL=http://127.0.0.1:8080

# Comma-separated SearXNG engines to request. Default: empty.
RAG_SEARXNG_ENGINES=

# SearXNG categories to request. Default: general.
RAG_SEARXNG_CATEGORIES=general

# SearXNG search language. Default: zh-CN.
RAG_SEARXNG_LANGUAGE=zh-CN

# Enable Google Scholar style search. Default: true.
RAG_SCHOLAR_ENABLED=true

# SerpAPI key used for scholar searches. Default: empty.
SERPAPI_API_KEY=

# Default number of scholar results, clamped from 1 to 20. Default: 5.
RAG_SCHOLAR_DEFAULT_COUNT=5

# Maximum number of scholar results, clamped from 1 to 20. Default: 20.
RAG_SCHOLAR_MAX_COUNT=20

# Scholar search engine name passed to the provider. Default: google_scholar.
RAG_SCHOLAR_ENGINE=google_scholar

# Maximum recent messages included in context. Default: 8.
RAG_MAX_RECENT_MESSAGES=8

# Number of recent full conversation turns preserved. Default: 3.
RAG_RECENT_FULL_TURNS=3

# Maximum characters allowed in constructed context. Default: 20000.
RAG_MAX_CONTEXT_CHARS=20000

# Maximum tokens allowed in constructed context. Default: 100000.
RAG_MAX_CONTEXT_TOKENS=100000

# Enable compression for live messages. Default: true.
RAG_LIVE_MESSAGES_COMPRESSION_ENABLED=true

# Number of live message turns kept before compression. Default: 1.
RAG_LIVE_MESSAGES_KEEP_TURNS=1

# Maximum characters fetched for live message compression. Default: 180.
RAG_LIVE_MESSAGES_MAX_FETCH_CHARS=180

# Maximum search results used for live message compression. Default: 3.
RAG_LIVE_MESSAGES_MAX_SEARCH_RESULTS=3

# Maximum reasoning/tool rounds per agent answer. Default: 8.
RAG_MAX_ROUNDS=8

# Minimum evidence score accepted during generation. Default: 0.0.
RAG_MIN_EVIDENCE_SCORE=0.0

# Allow query decomposition during generation. Default: false.
RAG_ALLOW_QUERY_DECOMPOSITION=false

# Enable LLM answer judge evaluation. Default: false.
RAG_EVAL_JUDGE_ENABLED=false

# API key for the answer judge, falling back to RAG_MODEL_API_KEY then DASHSCOPE_API_KEY. Default: empty.
RAG_EVAL_JUDGE_API_KEY=

# API base for the answer judge, falling back to RAG_MODEL_API_BASE. Default: https://dashscope.aliyuncs.com/compatible-mode/v1.
RAG_EVAL_JUDGE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model name for the answer judge, falling back to RAG_MODEL_NAME. Default: qwen3.6-plus.
RAG_EVAL_JUDGE_MODEL=qwen3.6-plus

# Enable LangSmith tracing integration. Default: false.
RAG_LANGSMITH_ENABLED=false

# Enable LangChain tracing v2. Default: false.
LANGCHAIN_TRACING_V2=false

# LangSmith API key. Default: empty.
LANGCHAIN_API_KEY=

# LangSmith project name. Default: agent-rag.
LANGCHAIN_PROJECT=agent-rag

# LangSmith endpoint URL. Default: empty.
LANGCHAIN_ENDPOINT=

# Directory containing harness skills. Default: skills.
RAG_SKILLS_DIR=skills

# Enable structured JSONL trace output. Default: true.
RAG_STRUCTURED_TRACE_ENABLED=true

# Directory for structured trace output. Default: runtime/traces.
RAG_STRUCTURED_TRACE_DIR=runtime/traces

# Semicolon-separated roots allowed for index paths. Default: ".".
RAG_ALLOWED_INDEX_ROOTS=.

# Allow fetching localhost URLs through web fetch tools. Default: true.
RAG_ALLOW_LOCAL_WEB_FETCH=true

# Allow fetching private-network URLs through web fetch tools. Default: true.
RAG_ALLOW_PRIVATE_WEB_FETCH=true

# Directory for background job state and logs. Default: runtime/jobs.
RAG_JOB_RUNTIME_DIR=runtime/jobs

# Maximum characters returned from a job log. Default: 12000.
RAG_JOB_MAX_LOG_CHARS=12000

# Path to persisted user memory. Default: runtime/user_memory.json.
RAG_USER_MEMORY_PATH=runtime/user_memory.json

# User id used for persisted memory. Default: default_user.
RAG_USER_ID=default_user
