# Required for model-backed agent runs.
AICODING_MODEL_API_KEY=

# Optional model configuration.
AICODING_MODEL_NAME=deepseek-chat
AICODING_MODEL_API_BASE=https://api.deepseek.com

# Optional harness configuration.
AICODING_RUNTIME_DIR=runtime
AICODING_TRACE_ENABLED=true
AICODING_MAX_CONTEXT_CHARS=16000
AICODING_COMMAND_TIMEOUT_SECONDS=60
AICODING_MAX_TOOL_ROUNDS=60
AICODING_ALLOWED_COMMANDS=pytest;python -m pytest;ruff check;python -m ruff check;pyright;python -m pyright;git status;git diff;git branch;rg
