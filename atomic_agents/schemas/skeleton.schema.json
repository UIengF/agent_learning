{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomic-agents.local/schemas/skeleton.schema.json",
  "title": "Skeleton",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "nodes",
    "edges",
    "run_limits",
    "irreversible_ops"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "run_limits": {
      "$ref": "#/$defs/run_limits"
    },
    "irreversible_ops": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "input_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "field"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "field": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "task",
        "depends_on",
        "inputs",
        "write_scope",
        "read_only",
        "required_capabilities",
        "reviewer_criteria",
        "output_file"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_ref"
          }
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_only": {
          "type": "boolean"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewer_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_file": {
          "type": "string"
        },
        "context_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "run_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_repair_attempts",
        "max_total_cost"
      ],
      "properties": {
        "max_repair_attempts": {
          "type": "integer"
        },
        "max_total_cost": {
          "type": "number"
        }
      }
    }
  }
}
